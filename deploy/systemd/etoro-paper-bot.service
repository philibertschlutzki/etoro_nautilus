# eToro Paper-Bot als systemd-User-Dienst. Installation: deploy/systemd/install.sh (siehe docs/SYSTEMD_BOT.md).
# Der Dienst läuft den Inkubations-Bot mit der aktuellen Whitelist. Die tägliche Auswahl bleibt im Orchestrator
# (PAPER_BOT_SYSTEMD_UNIT=etoro-paper-bot.service): er schreibt die Whitelist und startet/stoppt diesen Dienst.
[Unit]
Description=eToro Paper-Bot (Inkubation, Paper-Konto)
# Ohne Whitelist gibt es nichts zu handeln: erst der Orchestrator legt sie an.
ConditionPathExists=%h/etoro_nautilus/data/state/incubation_whitelist.json
# Maximal 5 Starts in 15 Minuten, danach Abbruch statt Endlosschleife (Wächter meldet den Ausfall).
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/etoro_nautilus
Environment=PYTHONUNBUFFERED=1
# Log wie bisher nach logs/incubation_bot_<Datum>.log (paper_report und ops_guard lesen dieses Muster).
ExecStart=/bin/bash -c 'exec %h/etoro_nautilus/venv/bin/python3 automation/momentum_ls_run.py --incubation --universe data/universe/momentum_ls.json --tournament data/state/incubation_whitelist.json >> logs/incubation_bot_$$(date -u +%%Y%%m%%d).log 2>&1'
Restart=always
RestartSec=30
# SIGTERM -> geordnetes Herunterfahren des Bots (live_risk.LiveShutdownCoordinator), danach SIGKILL.
TimeoutStopSec=90
KillSignal=SIGTERM

[Install]
WantedBy=default.target
