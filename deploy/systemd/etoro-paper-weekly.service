[Unit]
Description=eToro Paper-Bot wöchentlicher Bericht (Trades, Gebühren, Netto-Ergebnis)
ConditionPathExists=%h/etoro_nautilus/automation/paper_weekly_report.py

[Service]
Type=oneshot
WorkingDirectory=%h/etoro_nautilus
ExecStart=%h/etoro_nautilus/venv/bin/python -m automation.paper_weekly_report
StandardOutput=append:%h/etoro_nautilus/logs/paper_weekly.log
StandardError=append:%h/etoro_nautilus/logs/paper_weekly.log
