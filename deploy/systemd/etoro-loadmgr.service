[Unit]
Description=eToro Backtests mit Load-Management und automatischer Weiche Tages-/Stunden-Spur, ein Lauf = mehrere Blöcke
ConditionPathExists=%h/etoro_nautilus/automation/backtest_dispatch.py

[Service]
Type=oneshot
WorkingDirectory=%h/etoro_nautilus
Nice=19
ExecStart=/usr/bin/flock -n /tmp/etoro-loadmgr.lock %h/etoro_nautilus/venv/bin/python %h/etoro_nautilus/automation/backtest_loadmgr.py --once --burst-s 1500 --state %h/etoro_nautilus/results/loadmgr/state.json --symbols-cmd "%h/etoro_nautilus/venv/bin/python %h/etoro_nautilus/automation/backtest_dispatch.py --list-pending" --cmd "%h/etoro_nautilus/venv/bin/python %h/etoro_nautilus/automation/backtest_dispatch.py --run --ids {symbols} --workers {jobs}"
StandardOutput=append:%h/etoro_nautilus/logs/loadmgr.log
StandardError=append:%h/etoro_nautilus/logs/loadmgr.log
