
# automation/.env.example
# eToro Nautilus — automation/ Environment Variables
# Kopiere diese Datei nach automation/.env und fülle die Werte aus.
# Alternativ: .env im Projekt-Root (automation/ prüft dort als Fallback).
#
# NEVER commit .env mit echten Credentials!

# ── eToro API Credentials (Pflicht für alle Dienste) ─────────────────────────
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_CONFIRM_LIVE=1
# ── Universe Fetcher (Pflicht für universe_fetcher.py) ───────────────────────
# eToro-Username dessen Portfolio als Momentum-Universe verwendet wird
MOMENTUM_LS_USERNAME=momentum-LS

# ── Optionale Overrides ───────────────────────────────────────────────────────
# CATALOG_PATH=data/nautilus          # Default: data/nautilus (relativ zu PROJECT_ROOT)
# FLUSH_INTERVAL_SECONDS=3600         # Default: 3600 (catalog_service.py)
# UNIVERSE_MAX_AGE_HOURS=24           # Default: 24 (universe_fetcher.py)

# ── AI-Loop (Issues #1104-#1107, automation/ai_loop/) ─────────────────────────
# Self-contained closed-loop research assistant. Liest DIESELBE .env wie der Rest von
# automation/ (kein separates AI-Loop-.env) — siehe automation/ai_loop/__init__.py.
# DeepSeek API-Key (Pflicht, sobald automation/ai_loop/client.py verwendet wird).
DEEPSEEK_API_KEY=
# Optional: abweichende API-Basis-URL (Default: https://api.deepseek.com).
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Optional: Anfrage-Timeout in Sekunden (Default: 120).
# DEEPSEEK_TIMEOUT_S=120
# Obergrenze für Iterationen je AI-Loop-Lauf (automation/ai_loop/orchestrator.py, Default: 1).
AI_LOOP_MAX_ITERATIONS=1
# Max. Selbstheilungs-Versuche je Kandidat (Validierung/DeepSeek-Retries, Default: 3).
AI_LOOP_MAX_RETRIES=3


