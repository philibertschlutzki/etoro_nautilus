ETORO_API_KEY=dein_api_key
ETORO_USER_KEY=dein_user_key
MOMENTUM_LS_USERNAME=dein_etoro_username

# ── eToro Execution Mode ───────────────────────────────────────────────────────
# ETORO_ENV=demo              # 'demo' oder 'real'
# ETORO_DRY_RUN=1             # '1' für Dry-Run, '0' für echte Orders
# ETORO_ENABLE_TSL=0          # '1' zur Aktivierung von Trailing Stops
# ETORO_CONFIRM_LIVE=0        # Zwingend auf '1' setzen für echtes Live-Trading